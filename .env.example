# Example environment configuration
# Copy this file to .env (for production) or .env.test (for testing) and update with your values

# Firefly III API Configuration
FIREFLY_API_URL="https://your-firefly-instance.com/api/v1"
FIREFLY_API_TOKEN="your-api-token-here"

FIREFLY_ENABLED_ENTITIES="comma,separated,list" #account,bill,budget,category,piggy_bank,rule,rule_group,tag,transaction
FIREFLY_DIRECT_MODE=1 # If this is false or 0 a consolidated tool is registered

# Log level: DEBUG, INFO, WARNING, ERROR
FIREFLY_LOG_LEVEL=INFO

# Launcher / transport configuration (optional)
# Transport to use when launching the server: "stdio" or "streamable-http"
FIREFLY_MCP_TRANSPORT="streamable-http"
# Bind host/port/path for the Streamable HTTP transport
FIREFLY_MCP_HOST="0.0.0.0"
FIREFLY_MCP_PORT=8000
FIREFLY_MCP_PATH="/mcp"
